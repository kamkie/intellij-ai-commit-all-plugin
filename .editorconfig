root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
ij_wrap_on_typing = false

[config/detekt/baseline.xml]
ij_formatter_enabled = false

[*.{kt,kts}]
indent_size = 4
continuation_indent_size = 4
ktlint_code_style = intellij_idea
ij_kotlin_code_style_defaults = KOTLIN_OLD_DEFAULTS
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, ^
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = java.util.*, kotlinx.android.synthetic.**

[*.md]
indent_size = 2
tab_width = 2
ij_continuation_indent_size = 2
max_line_length = 999
trim_trailing_whitespace = true
ij_markdown_wrap_text_if_long = false
ij_markdown_wrap_text_inside_blockquotes = false
ij_markdown_keep_line_breaks_inside_text_blocks = true
ij_markdown_insert_quote_arrows_on_wrap = true
ij_markdown_format_tables = true
ij_markdown_keep_indents_on_empty_lines = false
ij_markdown_min_lines_around_header = 1
ij_markdown_max_lines_around_header = 1
ij_markdown_min_lines_around_block_elements = 1
ij_markdown_max_lines_around_block_elements = 1
ij_markdown_min_lines_between_paragraphs = 1
ij_markdown_max_lines_between_paragraphs = 1
ij_markdown_force_one_space_between_words = true
ij_markdown_force_one_space_after_header_symbol = true
ij_markdown_force_one_space_after_list_bullet = true
ij_markdown_force_one_space_after_blockquote_symbol = true

[*.{yml,yaml}]
indent_size = 2

[*.ps1]
indent_size = 4

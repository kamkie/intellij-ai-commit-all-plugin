<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>
    <depends>com.intellij.ml.llm</depends>

    <actions>
        <action
            id="pl.devopssolutions.aicommitall.actions.ThreeSectionControl"
            class="pl.devopssolutions.aicommitall.actions.AiCommitAllThreeSectionAction"
            text="AI Commit All"
            description="Generate an AI commit message, commit, or commit and push all Git changes."
            icon="/icons/aiCommitAll.svg">
            <add-to-group group-id="Vcs.Commit.PrimaryCommitActions" anchor="after" relative-to-action="Git.Commit.And.Push.Executor" />
        </action>
        <action
            id="pl.devopssolutions.aicommitall.actions.CommitShortcut"
            class="pl.devopssolutions.aicommitall.actions.AiCommitAllCommitShortcutAction"
            text="AI Commit All: Commit"
            description="Generate an AI commit message and commit all Git changes."
            use-shortcut-of="CheckinProject">
            <keyboard-shortcut first-keystroke="control K" keymap="$default" />
        </action>
        <action
            id="pl.devopssolutions.aicommitall.actions.PushShortcut"
            class="pl.devopssolutions.aicommitall.actions.AiCommitAllPushShortcutAction"
            text="AI Commit All: Push"
            description="Generate an AI commit message, commit all Git changes, and push."
            use-shortcut-of="Git.Commit.And.Push.Executor">
            <keyboard-shortcut first-keystroke="control alt K" keymap="$default" />
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <actionPromoter implementation="pl.devopssolutions.aicommitall.actions.AiCommitAllShortcutActionPromoter" />
        <postStartupActivity implementation="pl.devopssolutions.aicommitall.actions.AiCommitAllCommitToolbarStartupActivity" />
        <applicationConfigurable
            id="pl.devopssolutions.aicommitall.settings"
            displayName="AI Commit All"
            instance="pl.devopssolutions.aicommitall.settings.AiCommitAllConfigurable" />
        <notificationGroup
            id="AI Commit All"
            displayType="BALLOON"
            isLogByDefault="true" />
    </extensions>
</idea-plugin>

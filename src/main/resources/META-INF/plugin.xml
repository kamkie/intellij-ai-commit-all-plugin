<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>
    <depends>com.intellij.ml.llm</depends>

    <actions>
        <action
            id="pl.devopssolutions.aicommitall.actions.ThreeSectionControl"
            class="pl.devopssolutions.aicommitall.actions.AiCommitAllThreeSectionAction"
            text="AI Commit All"
            description="Generate an AI commit message, commit, or commit and push all Git changes."
            icon="/icons/aiCommitAll.svg">
            <add-to-group group-id="Vcs.Commit.PrimaryCommitActions" anchor="after" relative-to-action="Git.Commit.And.Push.Executor" />
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            id="pl.devopssolutions.aicommitall.settings"
            displayName="AI Commit All"
            instance="pl.devopssolutions.aicommitall.settings.AiCommitAllConfigurable" />
        <notificationGroup
            id="AI Commit All"
            displayType="BALLOON"
            isLogByDefault="true" />
    </extensions>
</idea-plugin>
